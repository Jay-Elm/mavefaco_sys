generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int         @id @default(autoincrement())
  name        String
  email       String      @unique
  password    String
  role        String      @default("customer")
  suspended   Boolean     @default(false)
  // Path inside the private "id-verification" Supabase Storage bucket, not
  // a public URL — access is only via short-lived signed URLs (see
  // /api/admin/users/[id]/id-image). Renamed from idImageUrl when ID
  // verification moved off a farmer-supplied free-text link.
  idImagePath String?
  // Farmer ID-document verification (admin-reviewed) — unrelated to
  // whether the account's email address has been confirmed.
  verified    Boolean     @default(false)
  // When `verified` last flipped true. Drives the auto-purge retention
  // clock for idImagePath (see /api/cron/purge-id-images) — cleared back
  // to null on unverify so a re-review has to restart the clock. Not the
  // same as "when the ID was submitted": a stale, never-reviewed
  // submission is deliberately never auto-purged.
  verifiedAt  DateTime?
  // Null until the address is confirmed via the emailed link. Existing
  // accounts are backfilled to non-null at migration time (see
  // 20260908120000_add_email_verification) so this gate only applies to
  // accounts created after this feature shipped — nobody already-registered
  // gets locked out.
  emailVerifiedAt DateTime?
  tokenVersion Int        @default(0)
  // Set when the account is deleted. Deleted accounts are anonymized, not
  // removed: orders, order items and audit-log entries that reference the
  // row stay intact, while name, email and credentials are scrubbed (see
  // src/lib/deleteAccount.ts). Every user-facing list skips these rows.
  deletedAt   DateTime?
  // AES-256-GCM ciphertext of the TOTP secret (never stored in the clear),
  // keyed off JWT_SECRET — see src/lib/totpCrypto.ts. Present as soon as an
  // admin/manager starts enrollment; `totpEnabled` is what actually gates
  // login, so a secret alone (enrollment started but never confirmed)
  // grants nothing.
  totpSecret  String?
  totpEnabled Boolean     @default(false)
  // The TOTP time-step (30s counter) of the last code this account
  // successfully authenticated with — rejects a replay of that same code
  // within its still-valid window. Cleared to null whenever the secret is
  // (re)generated (setup, admin reset), since a step number only makes
  // sense relative to the secret it was verified against.
  totpLastStep Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  products                 Product[]
  orders                   Order[]
  auditLogs                AuditLog[]
  announcements            Announcement[]
  reviews                  Review[]
  sentMessages             Message[] @relation("SentMessages")
  receivedMessages         Message[] @relation("ReceivedMessages")
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  emailChangeTokens        EmailChangeToken[]
  totpBackupCodes          TotpBackupCode[]
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  // SHA-256 hash of the token, never the raw value — same principle as
  // PasswordResetToken.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId    Int
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  // SHA-256 hash of the token, never the raw value — same principle as
  // passwords, so a DB read alone can't be used to reset someone's account.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId    Int
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

// A requested email change, waiting for the owner of the NEW address to
// click the link sent there. User.email only changes once they do, so a
// session holder can't silently move the account to an address they control.
model EmailChangeToken {
  id        Int       @id @default(autoincrement())
  // SHA-256 of the emailed token, never the raw value.
  tokenHash String    @unique
  newEmail  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId    Int
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model TotpBackupCode {
  id        Int       @id @default(autoincrement())
  // bcrypt hash, not SHA-256 — unlike PasswordResetToken these are
  // low-entropy, human-typed codes, so they need a slow hash to resist
  // offline brute force if the table ever leaks (same reasoning as
  // User.password).
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId    Int
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Category {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  createdAt   DateTime    @default(now())

  products    Product[]
}

model Product {
  id            Int         @id @default(autoincrement())
  name          String
  description   String
  price         Decimal     @db.Decimal(10, 2)
  stock         Float
  unit          String      @default("piece")
  imageUrl             String?
  approved             Boolean     @default(false)
  // Set instead of deleting once a product has history (orders, reviews,
  // crop logs) that still references it. Archived products are hidden
  // everywhere a live product appears (shop, farmer and staff lists,
  // checkout) but stay in order history and revenue reports.
  archivedAt           DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  plantingDate         DateTime?
  expectedHarvestDate  DateTime?
  growthStage          String?
  readyForHarvest      Boolean     @default(false)

  farmerId      Int
  farmer        User        @relation(fields: [farmerId], references: [id])

  categoryId    Int
  category      Category    @relation(fields: [categoryId], references: [id])

  orderItems    OrderItem[]
  reviews       Review[]
  cropLogs      CropLog[]

  @@index([farmerId])
  @@index([categoryId])
  // Storefront listings: approved, not archived, newest first.
  @@index([approved, archivedAt, createdAt])
}

model CropLog {
  id        Int      @id @default(autoincrement())
  type      String
  note      String
  createdAt DateTime @default(now())

  productId Int
  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([createdAt])
}

model Order {
  id              Int          @id @default(autoincrement())
  totalAmount     Decimal      @db.Decimal(10, 2)
  status          String       @default("pending")
  paymentMethod   String       @default("cod")
  deliveryMethod  String       @default("pickup")
  createdAt       DateTime     @default(now())

  customerId    Int
  customer      User         @relation(fields: [customerId], references: [id])

  items         OrderItem[]

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id            Int        @id @default(autoincrement())

  quantity      Float
  price         Decimal    @db.Decimal(10, 2)

  orderId       Int
  order         Order      @relation(fields: [orderId], references: [id])

  productId     Int
  product       Product    @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  type      String   @default("info")
  createdAt DateTime @default(now())

  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

model Banner {
  id           Int      @id @default(autoincrement())
  title        String
  subtitle     String?
  ctaText      String?
  ctaLink      String?
  color        String   @default("green")
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model Faq {
  id           Int      @id @default(autoincrement())
  question     String
  answer       String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model SiteContent {
  key   String @id
  value String
}

model Review {
  id         Int      @id @default(autoincrement())
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  customerId Int
  customer   User     @relation(fields: [customerId], references: [id])

  productId  Int
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([customerId, productId])

  @@index([productId])
}

model Message {
  id         Int      @id @default(autoincrement())
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  senderId   Int
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])

  receiverId Int
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId, receiverId])
  @@index([receiverId, read])
}

model AuditLog {
  id            Int        @id @default(autoincrement())

  action        String
  entityType    String
  entityId      Int
  timestamp     DateTime   @default(now())

  userId        Int
  user          User       @relation(fields: [userId], references: [id])

  @@index([userId])
}