generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int         @id @default(autoincrement())
  name        String
  email       String      @unique
  password    String
  role        String      @default("customer")
  suspended   Boolean     @default(false)
  // Path inside the private "id-verification" Supabase Storage bucket, not
  // a public URL — access is only via short-lived signed URLs (see
  // /api/admin/users/[id]/id-image). Renamed from idImageUrl when ID
  // verification moved off a farmer-supplied free-text link.
  idImagePath String?
  // Farmer ID-document verification (admin-reviewed) — unrelated to
  // whether the account's email address has been confirmed.
  verified    Boolean     @default(false)
  // When `verified` last flipped true. Drives the auto-purge retention
  // clock for idImagePath (see /api/cron/purge-id-images) — cleared back
  // to null on unverify so a re-review has to restart the clock. Not the
  // same as "when the ID was submitted": a stale, never-reviewed
  // submission is deliberately never auto-purged.
  verifiedAt  DateTime?
  // Null until the address is confirmed via the emailed link. Existing
  // accounts are backfilled to non-null at migration time (see
  // 20260908120000_add_email_verification) so this gate only applies to
  // accounts created after this feature shipped — nobody already-registered
  // gets locked out.
  emailVerifiedAt DateTime?
  tokenVersion Int        @default(0)
  // Set when the account is deleted. Deleted accounts are anonymized, not
  // removed: orders, order items and audit-log entries that reference the
  // row stay intact, while name, email and credentials are scrubbed (see
  // src/lib/deleteAccount.ts). Every user-facing list skips these rows.
  deletedAt   DateTime?
  // AES-256-GCM ciphertext of the TOTP secret (never stored in the clear),
  // keyed off JWT_SECRET — see src/lib/totpCrypto.ts. Present as soon as an
  // admin/manager starts enrollment; `totpEnabled` is what actually gates
  // login, so a secret alone (enrollment started but never confirmed)
  // grants nothing.
  totpSecret  String?
  totpEnabled Boolean     @default(false)
  // The TOTP time-step (30s counter) of the last code this account
  // successfully authenticated with — rejects a replay of that same code
  // within its still-valid window. Cleared to null whenever the secret is
  // (re)generated (setup, admin reset), since a step number only makes
  // sense relative to the secret it was verified against.
  totpLastStep Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  products                 Product[]
  orders                   Order[]
  auditLogs                AuditLog[]
  announcements            Announcement[]
  reviews                  Review[]
  sentMessages             Message[] @relation("SentMessages")
  receivedMessages         Message[] @relation("ReceivedMessages")
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  emailChangeTokens        EmailChangeToken[]
  totpBackupCodes          TotpBackupCode[]
  notices                  Notice[]
  plantings                Planting[]
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  // SHA-256 hash of the token, never the raw value — same principle as
  // PasswordResetToken.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId    Int
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  // SHA-256 hash of the token, never the raw value — same principle as
  // passwords, so a DB read alone can't be used to reset someone's account.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId    Int
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

// A requested email change, waiting for the owner of the NEW address to
// click the link sent there. User.email only changes once they do, so a
// session holder can't silently move the account to an address they control.
model EmailChangeToken {
  id        Int       @id @default(autoincrement())
  // SHA-256 of the emailed token, never the raw value.
  tokenHash String    @unique
  newEmail  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId    Int
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model TotpBackupCode {
  id        Int       @id @default(autoincrement())
  // bcrypt hash, not SHA-256 — unlike PasswordResetToken these are
  // low-entropy, human-typed codes, so they need a slow hash to resist
  // offline brute force if the table ever leaks (same reasoning as
  // User.password).
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId    Int
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Category {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  createdAt   DateTime    @default(now())

  products    Product[]
}

model Product {
  id            Int         @id @default(autoincrement())
  name          String
  description   String
  price         Decimal     @db.Decimal(10, 2)
  stock         Float
  unit          String      @default("piece")
  imageUrl             String?
  approved             Boolean     @default(false)
  // Set instead of deleting once a product has history (orders, reviews)
  // that still references it. Archived products are hidden
  // everywhere a live product appears (shop, farmer and staff lists,
  // checkout) but stay in order history and revenue reports.
  archivedAt           DateTime?
  // Set when staff suspend the listing (see /api/admin/products/[id]/suspend).
  // A suspended listing is unapproved and hidden from customers; the farmer
  // resubmits it by editing what customers see, which clears these fields.
  // Not resubmitted within SUSPENSION_DAYS, the daily cron deletes it (or
  // archives it, if it has history). Orders already placed carry on.
  suspendedAt          DateTime?
  suspensionReasons    String[]    @default([])
  suspensionNote       String?
  // The staff member who suspended it. A plain id rather than a relation:
  // it only attributes the cron's automatic removal in the audit log.
  suspendedById        Int?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  farmerId      Int
  farmer        User        @relation(fields: [farmerId], references: [id])

  categoryId    Int
  category      Category    @relation(fields: [categoryId], references: [id])

  orderItems    OrderItem[]
  reviews       Review[]
  plantings     Planting[]
  notices       Notice[]

  @@index([farmerId])
  @@index([categoryId])
  // Storefront listings: approved, not archived, newest first.
  @@index([approved, archivedAt, createdAt])
  @@index([suspendedAt])
}

// A crop the cooperative grows, with how long it typically takes. Staff
// manage the list; the figures are approximate and drive each planting's
// growth stage and expected harvest window (src/lib/planting.ts).
model CropType {
  id               Int        @id @default(autoincrement())
  name             String     @unique
  // Typical range of days from planting to harvest.
  daysToHarvestMin Int
  daysToHarvestMax Int
  // Day each growth stage starts; null for a stage the crop doesn't go
  // through (leafy vegetables are harvested before flowering).
  vegetativeDay    Int
  floweringDay     Int?
  fruitingDay      Int?
  createdAt        DateTime   @default(now())

  plantings        Planting[]
}

// One planting of one crop by one farmer: a season. Replanting is a new row,
// so past seasons stay comparable. Optionally tied to the listing its
// harvest is sold under.
model Planting {
  id                   Int        @id @default(autoincrement())
  // Calendar dates (no time of day), in Philippine time.
  plantedOn            DateTime   @db.Date
  // Copied from the crop type when the planting is recorded, then the
  // farmer's to adjust. Kept as columns so supply queries can filter on them.
  harvestStart         DateTime   @db.Date
  harvestEnd           DateTime   @db.Date
  areaSqm              Float?
  // Kilograms.
  expectedYield        Float?
  // growing | harvested | failed
  status               String     @default("growing")
  harvestedOn          DateTime?  @db.Date
  actualYield          Float?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  farmerId             Int
  farmer               User       @relation(fields: [farmerId], references: [id])

  cropTypeId           Int
  cropType             CropType   @relation(fields: [cropTypeId], references: [id])

  productId            Int?
  product              Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  logs                 CropLog[]

  @@index([farmerId, status])
  @@index([status, harvestStart])
  @@index([cropTypeId])
  @@index([productId])
}

model CropLog {
  id         Int      @id @default(autoincrement())
  // weather_impact | pest_disease | damage | note
  type       String
  note       String
  // When it was seen in the field, which may be before it was entered.
  observedOn DateTime @db.Date
  // low | medium | high; null for general notes.
  severity   String?
  // One of CROP_PESTS (src/validators/crop.ts), for pest_disease entries.
  pest       String?
  createdAt  DateTime @default(now())

  plantingId Int
  planting   Planting @relation(fields: [plantingId], references: [id], onDelete: Cascade)

  @@index([plantingId])
  @@index([observedOn])
}

model Order {
  id              Int          @id @default(autoincrement())
  totalAmount     Decimal      @db.Decimal(10, 2)
  status          String       @default("pending")
  paymentMethod   String       @default("cod")
  deliveryMethod  String       @default("pickup")
  createdAt       DateTime     @default(now())

  customerId    Int
  customer      User         @relation(fields: [customerId], references: [id])

  items         OrderItem[]

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id            Int        @id @default(autoincrement())

  quantity      Float
  price         Decimal    @db.Decimal(10, 2)

  orderId       Int
  order         Order      @relation(fields: [orderId], references: [id])

  productId     Int
  product       Product    @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  type      String   @default("info")
  createdAt DateTime @default(now())

  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

model Banner {
  id           Int      @id @default(autoincrement())
  title        String
  subtitle     String?
  ctaText      String?
  ctaLink      String?
  color        String   @default("green")
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model Faq {
  id           Int      @id @default(autoincrement())
  question     String
  answer       String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model SiteContent {
  key   String @id
  value String
}

model Review {
  id         Int      @id @default(autoincrement())
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  customerId Int
  customer   User     @relation(fields: [customerId], references: [id])

  productId  Int
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([customerId, productId])

  @@index([productId])
}

model Message {
  id         Int      @id @default(autoincrement())
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  senderId   Int
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])

  receiverId Int
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId, receiverId])
  @@index([receiverId, read])
}

// One-way notices from the system to a user (e.g. a listing suspension),
// shown in the farmer's Messages as "MaVeFaCo notices" with no reply box.
// Kept apart from Message because they have no sender to reply to.
model Notice {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipientId Int
  recipient   User     @relation(fields: [recipientId], references: [id])

  // The listing it's about, for the edit link. Cleared if the listing is
  // deleted; the notice text still says what happened.
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Set once what the notice asked for is done, so it stops offering its
  // action: "resubmitted" (the farmer fixed the listing) or "removed" (the
  // listing was deleted or archived). A later suspension of the same listing
  // gets a new notice.
  resolvedAt  DateTime?
  resolution  String?

  @@index([recipientId, read])
  @@index([productId])
}

model AuditLog {
  id            Int        @id @default(autoincrement())

  action        String
  entityType    String
  entityId      Int
  timestamp     DateTime   @default(now())

  userId        Int
  user          User       @relation(fields: [userId], references: [id])

  @@index([userId])
}